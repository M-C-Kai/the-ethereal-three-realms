# Python caches
__pycache__/
*.py[cod]

# Runtime logs and local process output
*.log
*.log.*
*.stderr
*.stdout

# Local account/character state
/implementation_staging/data/roles.json
/implementation_staging/data/roles.*.json
/implementation_staging/data/roles.json.bak*
/implementation_staging/data/accounts.json
/implementation_staging/data/gangs.json
/implementation_staging/data/consignment_listings.json
/implementation_staging/data/exchange_orders.json
/implementation_staging/data/sprite_catalog.json
/implementation_staging/logs/
/implementation_staging/runtime/

# Dynamic map runtime binaries; source-of-truth lives in maps/<id>/*.json.
# Existing tracked legacy .map.o files remain tracked despite these rules.
/implementation_staging/maps/[0-9]*.map.ref
/implementation_staging/maps/[0-9]*.map.o

# Signing credentials and packaged Android builds
*.p12
*.jks
*.keystore
*.apk
*.idsig

# Generated extraction/build workspaces
/implementation_staging/build_artifacts/*
!/implementation_staging/build_artifacts/
!/implementation_staging/build_artifacts/apk/
/implementation_staging/build_artifacts/apk/*
!/implementation_staging/build_artifacts/apk/APK_SHA256.txt
/implementation_staging/build/
/implementation_staging/work/
/implementation_staging/META-INF/

# Root-level diagnostic render outputs
/appearance-layer-audit/
/player_overlay_variants.png
/role_*_diagnostic.json
/role_*_diagnostic.png

# Editor and operating-system metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
.commandcode/
.vitepress/
node_modules
/package-lock.json
